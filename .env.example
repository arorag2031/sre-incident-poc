# Copy this file to .env in the same folder as docker-compose.yml
# Full field list: docs/run-on-another-machine.md
# Swap models without touching Java/Redis: docs/swap-llm-model.md

ALLOW_Display=True

# Chat LLM (OpenAI-compatible). Default provider is Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Must match on service-a and service-b (auth-lock demo)
INTERNAL_API_KEY=poc-internal-key
